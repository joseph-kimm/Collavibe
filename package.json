{
  "name": "collavibe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,mcp -c blue,magenta \"npm:dev:web\" \"npm:dev:mcp\"",
    "dev:web": "next dev",
    "dev:mcp": "tsx watch server/mcp.ts",
    "build": "next build",
    "start": "next start",
    "mcp": "tsx server/mcp.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "lucide-react": "0.468.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}

