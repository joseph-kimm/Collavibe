SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Exact public origin for OAuth discovery and token audience binding.
# For local cloud-backed testing, use http://127.0.0.1:4317.
COLLAVIBE_PUBLIC_URL=https://your-collavibe-deployment.vercel.app

# Optional meeting transcription. Server-side secrets only, never VITE_/NEXT_PUBLIC_.
# Default provides speaker labels and timestamps, not voice identity recognition.
# gpt-4o-transcribe-diarize retires on February 26, 2027; switch provider before then.
COLLAVIBE_AUDIO_PROVIDER=openai
OPENAI_API_KEY=
# Dedicated alternative (requires its own key):
# COLLAVIBE_AUDIO_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
