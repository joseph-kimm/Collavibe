{
  "name": "collavibe",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,mcp -c blue,magenta \"npm:dev:web\" \"npm:dev:mcp\"",
    "dev:web": "tsx watch server/http.ts",
    "dev:mcp": "tsx watch server/stdio.ts",
    "start": "tsx server/http.ts",
    "mcp": "tsx server/stdio.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
